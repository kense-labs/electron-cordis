@@ -102,6 +105,7 @@ class LinkerDriver(object):
             ('object_path_lto', self.prepare_object_path_lto),
             ('installnametoolpath,', self.set_install_name_tool_path),
             ('dsymutilpath,', self.set_dsymutil_path),
+            ('dsymthreads,', self.set_dsymutil_threads),
             ('strippath,', self.set_strip_path),
             ('otoolpath,', self.set_otool_path),
             ('nmpath,', self.set_nm_path),
@@ -125,6 +129,7 @@ class LinkerDriver(object):
         self._nm_cmd = ['xcrun', 'nm']
         self._install_name_tool_cmd = ['xcrun', 'install_name_tool']
         self._dsymutil_cmd = ['xcrun', 'dsymutil']
+        self._dsymutil_thread_args = []
         self._strip_cmd = ['xcrun', 'strip']
 
         # The linker output file, lazily computed in self._get_linker_output().
@@ -344,6 +349,7 @@ class LinkerDriver(object):
         dsymutil_env['PATH'] = ':'.join(tools_paths)
         subprocess.check_call(
             self._dsymutil_cmd
+            + self._dsymutil_thread_args
             + [
                 # TODO(crbug.com/532150826): Switch to `--linker parallel` when
                 # we figure out how to prevent memory/thread explosion.
@@ -372,6 +378,9 @@ class LinkerDriver(object):
         """
         self._dsymutil_cmd = [dsymutil_path]
 
+    def set_dsymutil_threads(self, threads):
+        self._dsymutil_thread_args = ['--num-threads', threads]
+
     def run_save_unstripped(self, unstripped_path_prefix):
         """Linker driver action for -Wcrl,unstripped,<unstripped_path_prefix>.
         Copies the linker output to |unstripped_path_prefix| before stripping.
diff --git a/build/toolchain/apple/toolchain.gni b/build/toolchain/apple/toolchain.gni
index 4d11300004..c496e61912 100644
--- a/build/toolchain/apple/toolchain.gni
+++ b/build/toolchain/apple/toolchain.gni
@@ -239,6 +239,10 @@ template("single_apple_toolchain") {
       dsym_switch += "-Wcrl,dsymutilpath," +
                      rebase_path("//tools/clang/dsymutil/bin/dsymutil",
                                  root_build_dir) + " "
+      assert(dsymutil_threads >= 0, "dsymutil thread count must be nonnegative")
+      if (dsymutil_threads > 0) {
+        dsym_switch += "-Wcrl,dsymthreads,$dsymutil_threads "
+      }
 
