{
  "schema": "electron-cordis.profile.v1",
  "name": "inkstone-headless",
  "description": "Zero-Chromium headless Inkstone & heterogeneous DSH Harness runtime (CLI / CI / daemon).",
  "plugins": [
    {
      "id": "@dsh/bridge-inkstone-tools",
      "runtime": "rust",
      "isolation": "in-process",
      "realm": "core",
      "inject": ["cap.os-shell"]
    },
    {
      "id": "@dsh/bridge-mcp",
      "runtime": "rust",
      "isolation": "in-process",
      "realm": "core",
      "inject": ["plane_b.tool_catalog"]
    },
    {
      "id": "@dsh/bridge-acp",
      "runtime": "rust",
      "isolation": "in-process",
      "realm": "core",
      "inject": ["plane_b.tool_catalog"]
    },
    {
      "id": "@dsh/llm-gateway",
      "runtime": "rust",
      "isolation": "in-process",
      "realm": "core"
    },
    {
      "id": "@dsh/cap-safe-storage",
      "runtime": "rust",
      "isolation": "trusted-host",
      "realm": "host"
    },
    {
      "id": "@dsh/cap-os-shell",
      "runtime": "rust",
      "isolation": "trusted-host",
      "realm": "host"
    },
    {
      "id": "@dsh/inkstone-harness",
      "runtime": "node-dsh",
      "isolation": "microvm",
      "realm": "core",
      "inject": ["bridge.inkstone_tools", "gateway.llm"],
      "config": {
        "entry": "dist/host-turn.js",
        "native_contract": "contracts/native"
      }
    }
  ]
}
