{
  "schema": "electron-cordis.profile.v1",
  "name": "dsh-studio",
  "description": "Electron-Cordis desktop profile for DeepSeek Harness (dsh).",
  "plugins": [
    {
      "id": "@dsh/bridge-mcp",
      "runtime": "rust",
      "isolation": "in-process",
      "realm": "core",
      "inject": ["plane_b.tool_catalog"]
    },
    {
      "id": "@dsh/bridge-acp",
      "runtime": "rust",
      "isolation": "in-process",
      "realm": "core",
      "inject": ["plane_b.tool_catalog"]
    },
    {
      "id": "@dsh/llm-gateway",
      "runtime": "rust",
      "isolation": "in-process",
      "realm": "core"
    },
    {
      "id": "@dsh/cap-safe-storage",
      "runtime": "rust",
      "isolation": "trusted-host",
      "realm": "host"
    },
    {
      "id": "@dsh/cap-clipboard",
      "runtime": "rust",
      "isolation": "trusted-host",
      "realm": "host"
    },
    {
      "id": "@dsh/cap-dialog",
      "runtime": "rust",
      "isolation": "trusted-host",
      "realm": "host"
    },
    {
      "id": "@dsh/cap-os-shell",
      "runtime": "rust",
      "isolation": "trusted-host",
      "realm": "host"
    },
    {
      "id": "@dsh/electron-web-surface",
      "runtime": "rust",
      "isolation": "trusted-host",
      "realm": "ui"
    },
    {
      "id": "@dsh/core-dsh-ts",
      "runtime": "rust",
      "isolation": "microvm",
      "realm": "core",
      "inject": ["ui.ready", "bridge.mcp", "bridge.acp"]
    }
  ]
}
